---
import type { Project } from '../data/profile';

interface Props {
  project: Project;
}

const { project: p } = Astro.props;
---

<article class="proj">
  <div>
    <div class="ttl"><h3>{p.name}</h3><span class="yr">{p.year}</span></div>
    <p>{p.text}</p>
    <ul class="chips" aria-label="Technologies">
      {p.stack.map((s) => <li>{s}</li>)}
    </ul>
  </div>
  <div class="btns no-print">
    {
      p.live && (
        <a class="btn primary" href={p.live} rel="noopener">
          View live site<span class="vh"> for {p.name}</span>
        </a>
      )
    }
    <a class="btn ghost" href={p.source} rel="noopener">View code<span class="vh"> for {p.name}</span></a>
  </div>
</article>

<style>
  .proj {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 12px 32px;
    padding: 20px 0 20px 16px;
    border-left: 4px solid var(--line);
    border-bottom: 1px solid var(--line);
    transition: border-left-color 0.15s;
  }

  .proj:hover,
  .proj:focus-within {
    border-left-color: var(--accent);
  }

  .proj:first-child {
    border-top: 1px solid var(--line);
  }

  .ttl {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
  }

  h3 {
    font-size: 1.3rem;
  }

  .yr {
    font-size: 0.85rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  p {
    color: var(--muted);
    margin-top: 6px;
    max-width: 58ch;
  }

  .btns {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-self: start;
    min-width: 150px;
  }

  @media (max-width: 640px) {
    .proj {
      grid-template-columns: 1fr;
    }

    .btns {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }

  @media print {
    .proj {
      grid-template-columns: 1fr;
      padding: 8px 0 8px 10px;
      break-inside: avoid;
    }
  }
</style>
