---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectRow from '../components/ProjectRow.astro';
import ContactForm from '../components/ContactForm.astro';
import { profile, projects, roles, skills, education, dateRange } from '../data/profile';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// The Resume buttons appear once the PDF is in public/.
const resume = existsSync(join(process.cwd(), 'public', profile.resume)) ? `${base}${profile.resume}` : null;

// The photo appears once src/assets/headshot.{jpg,png,webp} exists.
const photo = Object.values(
  import.meta.glob<{ default: ImageMetadata }>('../assets/headshot.{jpg,jpeg,png,webp}', { eager: true }),
)[0]?.default;

const main = projects.filter((p) => !p.more);
const more = projects.filter((p) => p.more);
---

<Base>
  <a class="skip" href="#main">Skip to content</a>
  <header class="top">
    <div class="wrap">
      <a class="brand" href="#top" aria-label={`${profile.name}, back to top`}>
        <span class="full" aria-hidden="true">Christopher <span class="last">Cortazo Rosas</span></span>
        <span class="ini" aria-hidden="true">CCR</span>
      </a>
      <div class="navr">
        <nav aria-label="Sections">
          <a href="#projects">Projects</a><a href="#experience">Experience</a><a href="#skills">Skills</a><a href="#contact">Contact</a>
        </nav>
        <button class="theme" id="theme" type="button" aria-label="Switch color theme" title="Switch color theme">
          <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"
            ><circle cx="12" cy="12" r="4"></circle><path
              d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg
          >
          <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
            ><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg
          >
        </button>
      </div>
    </div>
  </header>

  <main id="main">
    <div class="wrap" id="top">
      <div class:list={['hero', { 'has-photo': photo }]}>
        <div>
          <h1>{profile.name}</h1>
          <p class="lead">{profile.tagline}</p>
          <ul class="btns-row cta no-print">
            {resume && <li><a class="btn primary" href={resume}>Resume (PDF)</a></li>}
            <li><a class="btn ghost" href={profile.github} rel="me noopener">GitHub</a></li>
            <li><a class="btn ghost" href={profile.linkedin} rel="me noopener">LinkedIn</a></li>
          </ul>
        </div>
        {photo && <Image class="photo" src={photo} alt={profile.name} width={440} height={440} loading="eager" />}
      </div>
    </div>

    <section id="projects">
      <div class="wrap">
        <h2>Projects</h2>
        <p class="sub">Open the live site to try one, or read the code on GitHub.</p>
        <div>{main.map((p) => <ProjectRow project={p} />)}</div>
        {
          more.length > 0 && (
            <details class="more" id="more">
              <summary class="no-print">More projects ({more.length})</summary>
              <div>{more.map((p) => <ProjectRow project={p} />)}</div>
            </details>
          )
        }
      </div>
    </section>

    <section id="experience">
      <div class="wrap">
        <h2>Experience</h2>
        <p class="sub">Most recent first.</p>
        <ol class="jobs">
          {
            roles.map((r) => (
              <li class="job">
                <h3>
                  {r.title}, {r.org}
                </h3>
                <p class="meta">
                  <time datetime={r.start}>{dateRange(r)}</time> | {r.location}
                </p>
                <ul>
                  {r.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section id="skills">
      <div class="wrap">
        <h2>Skills</h2>
        <div class="skills">
          {
            skills.map((s) => (
              <div>
                <h3>{s.group}</h3>
                <p>{s.list}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section id="education">
      <div class="wrap">
        <h2>Education</h2>
        <h3 class="school">{education.school}</h3>
        <p class="meta">
          {education.degree}, class of <time datetime={String(education.year)}>{education.year}</time> | {education.location}
        </p>
      </div>
    </section>

    <section id="contact">
      <div class="wrap">
        <h2>Contact</h2>
        <p class="sub">Questions, ideas, or just want to say hi? Send me a note below or reach me anywhere here.</p>
        <ul class="btns-row no-print">
          <li><a class="btn primary" href={`mailto:${profile.email}`}>Email me</a></li>
          {resume && <li><a class="btn ghost" href={resume}>Download resume (PDF)</a></li>}
          <li><a class="btn ghost" href={profile.linkedin} rel="noopener">LinkedIn</a></li>
          <li><a class="btn ghost" href={profile.github} rel="noopener">GitHub</a></li>
        </ul>
        <p class="mail">
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
          <button class="linkbtn no-print" id="copymail" type="button" data-email={profile.email} hidden>Copy email</button>
          <span id="mailcopied" role="status" aria-live="polite"></span>
        </p>
        <ContactForm />
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap">
      <span>© {new Date().getFullYear()} {profile.name}</span>
      <span>Built with Astro, HTML, and CSS.</span>
    </div>
  </footer>
</Base>

<script>
  const $ = (id: string) => document.getElementById(id)!;

  // Theme toggle: flips whatever is showing now and remembers the choice.
  $('theme').addEventListener('click', () => {
    const root = document.documentElement;
    const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
    root.dataset.theme = dark ? 'light' : 'dark';
    try {
      localStorage.setItem('theme', root.dataset.theme);
    } catch {}
  });

  // Copy email.
  const copy = $('copymail');
  copy.hidden = false;
  copy.addEventListener('click', async () => {
    const msg = $('mailcopied');
    try {
      await navigator.clipboard.writeText(copy.dataset.email!);
      msg.textContent = 'Email copied.';
    } catch {
      msg.textContent = 'Select the address to copy it.';
    }
    setTimeout(() => (msg.textContent = ''), 3000);
  });

  // Underline the nav link for the section on screen.
  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>('nav a')].map((a) => [a.hash.slice(1), a]));
  const spy = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        links.forEach((l) => l.removeAttribute('aria-current'));
        links.get(e.target.id)?.setAttribute('aria-current', 'true');
      }
    },
    { rootMargin: '-40% 0px -55% 0px' },
  );
  document.querySelectorAll('main section').forEach((s) => spy.observe(s));

  // Printing: show every project.
  addEventListener('beforeprint', () => {
    const more = document.getElementById('more') as HTMLDetailsElement | null;
    if (more) more.open = true;
  });
</script>

<style>
  .skip {
    position: absolute;
    left: 16px;
    top: -60px;
    z-index: 10;
    background: var(--accent);
    color: var(--accent-ink);
    padding: 10px 16px;
    border-radius: 8px;
    font-weight: 600;
  }

  .skip:focus {
    top: 12px;
  }

  /* nav */
  header.top {
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  header.top .wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 56px;
  }

  .brand {
    font: 700 1.05rem var(--display);
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }

  .brand .ini {
    display: none;
  }

  .navr {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  nav {
    display: flex;
    gap: 18px;
    font-size: 0.95rem;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
    padding: 6px 0;
    border-bottom: 2px solid transparent;
  }

  nav a:hover {
    color: var(--ink);
  }

  nav a[aria-current='true'] {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }

  .theme {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    border: 1.5px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
  }

  .theme:hover {
    border-color: var(--accent);
  }

  .theme svg {
    width: 18px;
    height: 18px;
  }

  .theme .moon {
    display: none;
  }

  :global(:root[data-theme='dark']) .theme .sun {
    display: none;
  }

  :global(:root[data-theme='dark']) .theme .moon {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .theme .sun {
      display: none;
    }

    :global(:root:not([data-theme])) .theme .moon {
      display: block;
    }
  }

  @media (max-width: 640px) {
    .brand .last {
      display: none;
    }
  }

  @media (max-width: 560px) {
    nav a[href='#skills'] {
      display: none;
    }

    nav,
    .navr {
      gap: 12px;
    }
  }

  @media (max-width: 430px) {
    .brand .full {
      display: none;
    }

    .brand .ini {
      display: inline;
    }
  }

  @media (max-width: 360px) {
    nav,
    .navr {
      gap: 9px;
    }

    nav {
      font-size: 0.9rem;
    }
  }

  /* hero */
  .hero {
    padding: 64px 0 48px;
  }

  .hero.has-photo {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 32px 48px;
    align-items: center;
  }

  h1 {
    font-size: clamp(2.5rem, 7vw, 4.25rem);
    max-width: 14ch;
  }

  .lead {
    margin-top: 20px;
    max-width: 56ch;
    font-size: 1.2rem;
    color: var(--muted);
  }

  .cta {
    margin-top: 28px;
  }

  .photo {
    width: 220px;
    height: 220px;
    border-radius: 24px;
    object-fit: cover;
    border: 1px solid var(--line);
  }

  @media (max-width: 760px) {
    .hero.has-photo {
      grid-template-columns: 1fr;
    }

    .photo {
      order: -1;
      width: 120px;
      height: 120px;
      border-radius: 50%;
    }
  }

  /* projects */
  details.more {
    margin-top: 8px;
  }

  details.more summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--accent);
    padding: 14px 0;
    list-style-position: inside;
  }

  details.more summary:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* experience: a timeline */
  .jobs {
    list-style: none;
    margin: 0;
    padding: 0 0 0 22px;
    border-left: 2px solid var(--line);
  }

  .job {
    position: relative;
    padding: 0 0 32px 8px;
  }

  .job:last-child {
    padding-bottom: 0;
  }

  .job::before {
    content: '';
    position: absolute;
    left: -31px;
    top: 8px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--bg);
    border: 3px solid var(--accent);
  }

  .job h3 {
    font-size: 1.25rem;
  }

  .meta {
    color: var(--muted);
    font-size: 0.95rem;
    margin: 2px 0 10px;
  }

  .job ul {
    margin: 0;
    padding-left: 20px;
  }

  .job li {
    margin: 6px 0;
    max-width: 68ch;
  }

  /* skills */
  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px 32px;
  }

  .skills h3 {
    font-size: 1.05rem;
    margin-bottom: 6px;
  }

  .skills p {
    color: var(--muted);
  }

  /* education */
  .school {
    font-size: 1.25rem;
    margin-top: 8px;
  }

  /* contact */
  .mail {
    margin-top: 20px;
    color: var(--muted);
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    align-items: center;
  }

  .mail a {
    font-weight: 600;
  }

  footer {
    padding: 32px 0 56px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.9rem;
  }

  footer .wrap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
  }

  @media print {
    header.top,
    .skip,
    footer {
      display: none;
    }

    .hero {
      padding: 0 0 10px;
    }

    h1 {
      font-size: 22pt;
      max-width: none;
    }

    .job {
      break-inside: avoid;
    }
  }
</style>
